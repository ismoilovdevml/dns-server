[Unit]
Description=Authoritative DNS server (vega)
Documentation=https://github.com/ismoilovdevml/vega
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vega --config /etc/vega/vega.toml

# Refuse to start on a bad config rather than failing halfway through startup.
# `check` is a subcommand, not a flag — passing `--check` makes ExecStartPre exit
# 2, which with Type=simple means ExecStart never runs at all.
ExecStartPre=/usr/local/bin/vega check --config /etc/vega/vega.toml

# Records can be changed without a restart: edit the config and POST /reload, or
# use `vega record add --reload`. Listener addresses and the rate limiter
# are not hot-swappable and do need a restart.

# --- Stopping ----------------------------------------------------------------
# On SIGTERM the process marks itself unready, keeps answering DNS for
# shutdown_drain_secs (default 15s), then closes the listeners and exits. Give
# it room: drain 15s + 5s stop budget + 2s watchdog = 22s, so 30s leaves 8s of
# slop and matches terminationGracePeriodSeconds in the Kubernetes manifest.
# 45s was arbitrary — the in-process watchdog guarantees the process is gone by
# 22s, so the extra 23s were spent waiting on a process that was already dead.
# (That drain landed after 0.2.0. On 0.2.0 the process exits immediately and
# this timeout is only ever an unused upper bound.)
# Raise this whenever you raise shutdown_drain_secs; deploy/check-shutdown-
# invariants.sh fails CI if the two drift apart.
KillSignal=SIGTERM
# SIGTERM to the main process only — the drain is its job and it must not be
# raced by signals to its threads — then SIGKILL the whole cgroup if it is late.
KillMode=mixed
TimeoutStopSec=30
# Default, stated explicitly: a wedged process must still die. This is the
# escape hatch that lets us refuse to reimplement "exit now" in-process.
SendSIGKILL=yes

# `on-failure` would not restart after a clean exit — and the process exits 0 on
# SIGTERM, so a stray `killall` would leave the name server down with systemd
# perfectly content. A name server should always come back.
Restart=always
RestartSec=2s

User=vega
Group=vega
DynamicUser=no

# Binding :53 as a non-root user needs exactly this capability, nothing more.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# --- Sandboxing --------------------------------------------------------------
# A name server reads one config file and talks to the network. Everything else
# it could touch is a liability, so take it away.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ReadOnlyPaths=/etc/vega

# --- Resource limits ---------------------------------------------------------
LimitNOFILE=65535
MemoryMax=256M
TasksMax=256

# Structured logs go to the journal; use `journalctl -u vega -f`.
Environment=VEGA_LOG_FORMAT=pretty
Environment=VEGA_LOG_LEVEL=info
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
